# @leontechrepo/leon-ui is published to GitHub Packages.
# LEON_UI_TOKEN must be a token with `read:packages` on the leontechrepo org.
# Local: set in frontend/.env or frontend/.env.local and load before npm install.
# CI: map secrets.LEON_UI_TOKEN into the job env.
@leontechrepo:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${LEON_UI_TOKEN}

DATABASE_URL=postgresql+asyncpg://leon:leon@localhost:5432/hc_deals

# Microsoft Graph (Azure App Registration — client credentials flow)
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# Two monitored inboxes (full email addresses)
MONITORED_USER_1=user1@leonhealthcarepartners.com
MONITORED_USER_2=user2@leonhealthcarepartners.com

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Email scan interval in minutes (default: 240 = every 4 hours)
SCAN_INTERVAL_MINUTES=240

# Clerk JWKS endpoint for backend JWT verification
# Format: https://<your-clerk-instance>.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
